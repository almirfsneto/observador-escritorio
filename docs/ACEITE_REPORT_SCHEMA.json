{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "report_id",
    "created_utc",
    "origin",
    "pilot_authorized",
    "human_gate",
    "environment",
    "source",
    "artifacts",
    "checks",
    "automated_tests",
    "manual_checks",
