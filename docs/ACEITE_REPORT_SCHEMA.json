        "os_edition": {
          "type": "string",
          "enum": [
            "Home",
            "HomeSingleLanguage",
            "Pro",
            "Enterprise",
            "EnterpriseLTSC",
            "Education",
            "Server",
            "unknown"
          ]
        },
        "os_build": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "python": {
          "type": "string",
          "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,5}$"
        },
        "tk": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}(?:\\.[0-9]{1,5})?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dotnet_sdk": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,5}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
