{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "pilot_authorized",
    "sample_sequence",
    "scope",
    "agent",
    "native",
    "python",
    "writer",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "synthetic_lab_diagnostics"
    },
    "pilot_authorized": {
      "const": false
    },
    "sample_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "scope": {
      "const": "component_lifetimes_not_global"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "uptime_ms"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "disabled",
            "starting",
            "active",
            "pausing",
            "paused",
            "stopped",
            "expired"
          ]
        },
        "uptime_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000.0
        }
      }
    },
    "native": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sample_age_ms",
            "dropped",
            "callbacks",
            "queues"
          ],
          "properties": {
            "sample_age_ms": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0
            },
            "dropped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "callbacks": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "focus",
                "invoke",
                "toggle",
                "excluded",
                "errors"
              ],
              "properties": {
                "focus": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "invoke": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "toggle": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "excluded": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "errors": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                }
              }
            },
            "queues": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "output_depth",
                    "output_capacity",
                    "focus_depth",
                    "focus_capacity"
                  ],
                  "properties": {
                    "output_depth": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854775807
                    },
                    "output_capacity": {
                      "const": 512
                    },
                    "focus_depth": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854775807
                    },
                    "focus_capacity": {
                      "const": 256
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "python": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "stopped",
            "ready",
            "pending_ack",
            "expired",
            "flow",
            "buffered",
            "capacity",
            "invalid_messages",
            "sequence_gaps"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "stopped": {
              "type": "boolean"
            },
            "ready": {
              "type": "boolean"
            },
            "pending_ack": {
              "type": "boolean"
            },
            "expired": {
              "type": "boolean"
            },
            "flow": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "received",
                "accepted",
                "rejected",
                "coalesced",
                "overflow",
                "drained",
                "discarded"
              ],
              "properties": {
                "received": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "accepted": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "rejected": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "coalesced": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "overflow": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "drained": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "discarded": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                }
              }
            },
            "buffered": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "capacity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "invalid_messages": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "sequence_gaps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "writer": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "health",
            "shutdown",
            "worker_alive",
            "capacity_batches",
            "row_balance",
            "ledger",
            "last_batch_ms",
            "storage"
          ],
          "properties": {
            "health": {
              "type": "string",
              "enum": [
                "starting",
                "ready",
                "quota_full",
                "storage_unavailable",
                "shutdown_timeout"
              ]
            },
            "shutdown": {
              "type": "boolean"
            },
            "worker_alive": {
              "type": "boolean"
            },
            "capacity_batches": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "row_balance": {
              "type": "string",
              "enum": [
                "balanced",
                "unreconciled",
                "unavailable"
              ]
            },
            "ledger": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "received",
                "enqueued",
                "ingress_rejected",
                "buffered",
                "inflight",
                "written",
                "duplicates",
                "write_rejected",
                "uncertain"
              ],
              "properties": {
                "received": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "enqueued": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "ingress_rejected": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "buffered": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "inflight": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "written": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "duplicates": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "write_rejected": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "uncertain": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                }
              }
            },
            "last_batch_ms": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000.0
                },
                {
                  "type": "null"
                }
              ]
            },
            "storage": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rows_at_open",
                    "rows_current",
                    "purged",
                    "last_error",
                    "budget"
                  ],
                  "properties": {
                    "rows_at_open": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854775807
                    },
                    "rows_current": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9223372036854775807
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "purged": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854775807
                    },
                    "last_error": {
                      "type": "string",
                      "enum": [
                        "none",
                        "busy",
                        "full",
                        "io",
                        "projection",
                        "post_commit",
                        "rollback_failed",
                        "commit_unknown"
                      ]
                    },
                    "budget": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "limit_bytes",
                        "reserve_bytes",
                        "observed_bytes",
                        "peak_observed_bytes",
                        "observations",
                        "physical_quota"
                      ],
                      "properties": {
                        "limit_bytes": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9223372036854775807
                        },
                        "reserve_bytes": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9223372036854775807
                        },
                        "observed_bytes": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9223372036854775807
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "peak_observed_bytes": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9223372036854775807
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "observations": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9223372036854775807
                        },
                        "physical_quota": {
                          "const": false
                        }
                      }
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "gaps": {
      "type": "array",
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "component_snapshots_not_atomic",
          "native_sample_unavailable",
          "native_sample_stale",
          "native_queue_unavailable",
          "writer_unavailable",
          "volatile_counters_reset_on_restart",
          "budget_not_os_quota",
          "sampling_not_continuous",
          "native_and_python_phases_differ",
          "purge_includes_preexisting_rows",
          "commit_outcome_uncertain",
          "human_acceptance_pending",
          "row_balance_not_proven",
          "writer_shutdown_incomplete"
        ]
      }
    }
  }
}
